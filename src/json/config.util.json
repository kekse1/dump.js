{

	/* globally enable/disable this project */
	"enabled": true,

	/* possibility to globally disable all ansi escape sequences (styles/colors/..) */
	"ansi": true,

	/* sort results; either (null) for NO sort, or a boolean to define
	       	the direction (asc/desc); ... */
	"sort": null,

	/* default radix (base) */
	"radix": 10,

	/* with default radix (10) the numbers can also be adapted to your locale setting */
	"locale": true,

	/* without any beautify or so, only assignments; like `10=64`; see also 'separator' below */
	"pairs": false,

	/* or you enable the regular 'list' output.. will be overridden by 'pairs'. */
	"list": false,

	/* if with 'pairs' or 'list' is enabled (see above), this is the separator..
		defaults to newline '\n'. */
	"sep": "\n",

	/* space between the items.. too compact is worse to take a look at it... */
	"spaces": 3,

	/* also show empty items? comment: this won't happen always, depending
		on output type and ansi (param/config) state.. */
	"empty": false,

	/* shows the characters (only printable ones) with their mapped character, not byte values.. */
	"printable": false,

	/* summary .. eingefuehrt wg. `util.count`, dass die anzahl an bytes w/ math.size; ..
		... v.a. wg. '--only' bzw. '--without' sinnvoll! ;-) ... */
	"summary": true,

	/* the 'print' utility can also print 'ansi' characters, so these *above* 127... */
	"above": true,

	/* when e.g. `rot13` should be outputted without control characters, ... */
	"filter": true

}
