{
	"project": {
		"type": "directory",
		"required": true
	},
	"script": {
		"type": "directory",
		"required": true
	},
	"config": {
		"type": "file",
		"required": true
	},
	"radix": {
	       "type": "radix",
	       "required": false,
	       "disable": "locale"
	},
	"order": {
		"type": [ "boolean", "null" ],
		"required": false
	},
	"offset": {
		"type": "integer",
		"required": false
	},
	"size": {
		"type": "integer",
		"required": false
	},
	"locale": {
		"type": "boolean",
		"required": false,
		"disable": "radix"
	},
	"ansi": {
		"type": "boolean",
		"required": false
	},
	"pairs": {
		"type": "boolean",
		"required": false,
		"disable": "list"
	},
	"sep": {
		"type": "string",
		"required": false
	},
	"list": {
		"type": "boolean",
		"required": false,
		"disable": "pairs"
	},
	"spaces": {
		"type": "integer",
		"required": false
	},
	"empty": {
		"type": "boolean",
		"required": false
	},
	"without": {
		"type": [ "string", "integer" ],
		"required": false
	},
	"only": {
		"type": [ "string", "integer" ],
		"required": false
	},
	"high": {
		"type": [ "string", "integer" ],
		"required": false
	}
}
